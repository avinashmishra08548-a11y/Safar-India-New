rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidBookingData(data) {
      return data is map &&
        (!('id' in data) || (data.id is string && data.id.size() >= 1 && data.id.size() <= 64)) &&
        (!('totalFare' in data) || (data.totalFare is number && data.totalFare >= 0 && data.totalFare <= 10000000)) &&
        (!('status' in data) || data.status in ['confirmed', 'active', 'assigned', 'in_progress', 'completed', 'cancelled', 'pending']);
    }

    match /bookings/{bookingId} {
      allow get, list: if true;
      allow create, update: if isValidBookingData(request.resource.data);
      allow delete: if false;
    }

    match /booking_counters/{counterId} {
      allow get, list: if true;
      allow create, update: if request.resource.data is map;
      allow delete: if false;
    }

    match /payment_logs/{logId} {
      allow get, list: if true;
      allow create, update: if request.resource.data is map;
      allow delete: if false;
    }

    match /system_metadata/{docId} {
      allow get, list: if true;
      allow create, update: if request.resource.data is map;
      allow delete: if false;
    }
  }
}
