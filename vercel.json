{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/com.safarindiacabs.app-release.aab",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"com.safarindiacabs.app-release.aab\""
        }
      ]
    },
    {
      "source": "/com.safarindiacabs.app-release.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"com.safarindiacabs.app-release.apk\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/create-order",
      "destination": "/api/payment-gateway?endpoint=create-order"
    },
    {
      "source": "/api/verify-payment",
      "destination": "/api/payment-gateway?endpoint=verify-payment"
    },
    {
      "source": "/api/razorpay-webhook",
      "destination": "/api/payment-gateway?endpoint=webhook"
    },
    {
      "source": "/api/booking-notifications",
      "destination": "/api/send-booking-sms?endpoint=booking-notifications"
    },
    {
      "source": "/api/assign-driver",
      "destination": "/api/send-booking-sms?endpoint=assign-driver"
    },
    {
      "source": "/api/send-driver-sms",
      "destination": "/api/send-booking-sms?endpoint=send-driver-sms"
    },
    {
      "source": "/api/send-review-email",
      "destination": "/api/send-booking-sms?endpoint=send-review-email"
    },
    {
      "source": "/api/verify-otp",
      "destination": "/api/send-booking-sms?endpoint=verify-otp"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/.well-known/assetlinks.json"
    },
    {
      "source": "/com.safarindiacabs.app-release.aab",
      "destination": "/com.safarindiacabs.app-release.aab"
    },
    {
      "source": "/com.safarindiacabs.app-release.apk",
      "destination": "/com.safarindiacabs.app-release.apk"
    },
    {
      "source": "/safarindiacabs-release.keystore",
      "destination": "/safarindiacabs-release.keystore"
    },
    {
      "source": "/((?!api/|assets/|\\.well-known/|com\\.safarindiacabs\\.app-release\\.aab|com\\.safarindiacabs\\.app-release\\.apk|safarindiacabs-release\\.keystore|robots\\.txt|sitemap\\.xml|privacy-policy\\.html|terms-and-conditions\\.html|refund-policy\\.html|delete-account\\.html|contact-us\\.html|favicon\\.svg|manifest\\.json|sw\\.js|logo\\.png|icon-192\\.png|icon-512\\.png|icon-512-maskable\\.png|apple-touch-icon\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
