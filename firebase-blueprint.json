{
  "entities": {
    "BookingRecord": {
      "title": "BookingRecord",
      "description": "SafarIndiaCabs customer cab booking and GST billing record with sequential SIC26XX booking ID",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Sequential Booking ID starting with SIC (e.g. SIC2601, SIC2604, SIC2605)"
        },
        "bookingId": {
          "type": "string",
          "description": "Indexed human-readable Booking Reference ID (e.g. SIC2604)"
        },
        "bookingReference": {
          "type": "string",
          "description": "Human-readable Booking Reference ID alias (e.g. SIC2604)"
        },
        "sequenceNumber": {
          "type": "number",
          "description": "Sequential numeric counter for the booking ID (e.g. 1, 2, 3, 4)"
        },
        "searchKeywords": {
          "type": "array",
          "description": "Normalized uppercase search keywords (booking ID, digits, phone, name, cities)"
        },
        "tripType": {
          "type": "string",
          "enum": ["oneway", "roundtrip", "local", "airport"]
        },
        "tripDays": {
          "type": "number"
        },
        "pickupCity": {
          "type": "string"
        },
        "dropCity": {
          "type": "string"
        },
        "pickupAddress": {
          "type": "string"
        },
        "dropAddress": {
          "type": "string"
        },
        "pickupDate": {
          "type": "string"
        },
        "pickupTime": {
          "type": "string"
        },
        "cabId": {
          "type": "string"
        },
        "cabName": {
          "type": "string"
        },
        "distanceKm": {
          "type": "number"
        },
        "baseFare": {
          "type": "number"
        },
        "driverAllowance": {
          "type": "number"
        },
        "tollsAndTaxes": {
          "type": "number"
        },
        "highwayToll": {
          "type": "number"
        },
        "statePermitTax": {
          "type": "number"
        },
        "hillStationCharge": {
          "type": "number"
        },
        "nightCharge": {
          "type": "number"
        },
        "gstAmount": {
          "type": "number"
        },
        "totalFare": {
          "type": "number"
        },
        "advancePaid": {
          "type": "number"
        },
        "balanceDue": {
          "type": "number"
        },
        "paymentMode": {
          "type": "string",
          "enum": ["advance_20", "full"]
        },
        "paymentMethod": {
          "type": "string"
        },
        "transactionId": {
          "type": "string"
        },
        "customerName": {
          "type": "string"
        },
        "customerPhone": {
          "type": "string"
        },
        "customerEmail": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "completed", "cancelled"]
        },
        "driverName": {
          "type": "string"
        },
        "driverPhone": {
          "type": "string"
        },
        "driverVehicleModel": {
          "type": "string"
        },
        "driverVehicleNo": {
          "type": "string"
        },
        "driverAssignedAt": {
          "type": "string"
        },
        "pickupCoords": {
          "type": "object",
          "description": "Pickup GPS coordinates { lat, lng }"
        },
        "dropCoords": {
          "type": "object",
          "description": "Drop GPS coordinates { lat, lng }"
        },
        "routeProvider": {
          "type": "string",
          "description": "Routing provider used (ola_maps, mappls, osrm_india_road, verified_highway_network)"
        },
        "routeSummary": {
          "type": "string",
          "description": "Selected highway corridor summary"
        },
        "routeDurationText": {
          "type": "string",
          "description": "Estimated travel duration text"
        },
        "routeGeometry": {
          "type": "array",
          "description": "Bounded road polyline coordinates [[lng, lat]]"
        },
        "fareSnapshot": {
          "type": "object",
          "description": "Immutable snapshot of distance and fare components at booking confirmation"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tripType",
        "pickupCity",
        "dropCity",
        "pickupDate",
        "pickupTime",
        "cabId",
        "cabName",
        "distanceKm",
        "baseFare",
        "totalFare",
        "customerName",
        "customerPhone",
        "status",
        "createdAt"
      ]
    },
    "BookingCounter": {
      "title": "BookingCounter",
      "description": "Sequential counter document tracking the latest SIC26XX booking number",
      "type": "object",
      "properties": {
        "seriesPrefix": {
          "type": "string"
        },
        "currentSequence": {
          "type": "number"
        },
        "lastBookingId": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["seriesPrefix", "currentSequence", "lastBookingId", "updatedAt"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": {
        "$ref": "#/entities/BookingRecord"
      },
      "description": "Stores customer cab bookings and billing invoices indexed by sequential Booking ID (e.g. SIC2601)"
    },
    "/booking_counters/{counterId}": {
      "schema": {
        "$ref": "#/entities/BookingCounter"
      },
      "description": "Stores atomic sequential booking ID counter state for SIC26XX series"
    }
  }
}
